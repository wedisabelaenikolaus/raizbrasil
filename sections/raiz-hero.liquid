{{ 'section-raiz-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign is_first = false
  assign btn_scheme = 'scheme-1'
  if section.settings.text_tone == 'light'
    assign btn_scheme = 'scheme-3'
  endif
  if section.index == 1
    assign is_first = true
  endif
-%}

<section
  class="raiz-hero raiz-hero--{{ section.settings.height }} raiz-hero--v-{{ section.settings.vertical_position }} raiz-hero--h-{{ section.settings.horizontal_position }} raiz-hero--{{ section.settings.text_tone }}"
  style="--raiz-hero-overlay: {{ overlay }};"
>
  <div class="raiz-hero__media">
    {%- if is_first -%}
      {% render 'raiz-image',
        image: section.settings.image,
        placeholder: 'hero-apparel-1',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1800, 2200, 2600',
        loading: 'eager',
        priority: 'high'
      %}
    {%- else -%}
      {% render 'raiz-image',
        image: section.settings.image,
        placeholder: 'hero-apparel-1',
        sizes: '100vw',
        widths: '750, 1100, 1500, 1800, 2200, 2600'
      %}
    {%- endif -%}
  </div>

  <div class="raiz-hero__inner page-width">
    <div class="raiz-hero__content color-{{ btn_scheme }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="raiz-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="raiz-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="raiz-hero__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="raiz-hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              class="button"
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              class="button button--secondary"
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAIZ Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Use your own licensed photography. Recommended: landscape, at least 2400 px wide. The focal point controls the mobile crop."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Brazilian lifestyle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A LITTLE PIECE OF BRAZIL."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Discover authentic Brazilian beachwear, beautiful textiles and everyday escapes."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical content position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Horizontal content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Text colour",
      "options": [
        { "value": "light", "label": "Light text (on dark photos)" },
        { "value": "dark", "label": "Dark text (on light photos)" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "info": "Increase if text is hard to read on your photo (WCAG AA needs 4.5:1).",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "RAIZ Hero"
    }
  ]
}
{% endschema %}
